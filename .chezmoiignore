# Skills in the lockfile belong to `npx skills`. It rewrites those folders on
# update, so chezmoi must skip them or it reports drift forever. Names are read
# from the lockfile at apply time, so none are stored in this repo.
{{- $lock := joinPath .chezmoi.homeDir ".agents/.skill-lock.json" }}
{{- if stat $lock }}
{{- range $name, $_ := (fromJson (output "cat" $lock)).skills }}
.agents/skills/{{ $name }}
{{- end }}
{{- end }}
.agents/.skill-lock.json
