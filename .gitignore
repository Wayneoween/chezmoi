# macos...
.DS_Store
dot_DS_Store

# Chezmoi auto-creates this when permissions are granted in a session — not for tracking.
.claude/

# Local-only: internal infra scaffolding, kept on disk but never committed here.
code/

dot_agents/plans/*
# Skills in ~/.agents/skills. Same allowlist as .chezmoiignore.
# origin is public. Never allowlist a skill from a private repo.
dot_agents/skills/*
dot_agents/dot_skill-lock.json
!dot_agents/skills/anti-ai-writing-style/
!dot_agents/skills/archify/
!dot_agents/skills/simple-english/

# Plans are scratch thinking, not config. Repo is public on GitHub.
# .chezmoiignore already keeps docs/ out of $HOME; this keeps them off the remote.
**/docs/plans/
