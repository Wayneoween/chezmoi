# macos...
.DS_Store
dot_DS_Store

# Chezmoi auto-creates this when permissions are granted in a session — not for tracking.
.claude/

# Local-only: internal infra scaffolding, kept on disk but never committed here.
code/

dot_agents/plans/*
# Skills live in ~/.agents/skills. The lockfile decides who owns each one:
#
#   in .skill-lock.json  -> `npx skills` owns it. .chezmoiignore skips it, so
#                           allowlisting it here is dead weight: the file gets
#                           committed but chezmoi never applies it. A new
#                           machine gets it back by re-running `npx skills`.
#   not in the lockfile  -> chezmoi owns it. Allowlist it below, or it exists
#                           only on the machine that created it.
#
# The wildcard keeps vendored and work-internal skills out of this repo by
# default. origin is public, so never allowlist anything sourced from a private
# repo.
#
# TODO: most entries below are in the lockfile and are dead weight. Only
# anti-ai-writing-style and simple-english still qualify. Drop the rest with
# `git rm -r --cached`.
dot_agents/skills/*
dot_agents/dot_skill-lock.json
!dot_agents/skills/anti-ai-writing-style/
!dot_agents/skills/avoid-ai-writing/
!dot_agents/skills/codebase-design/
!dot_agents/skills/domain-modeling/
!dot_agents/skills/git-commit/
!dot_agents/skills/grill-with-docs/
!dot_agents/skills/grilling/
!dot_agents/skills/handoff/
!dot_agents/skills/improve-codebase-architecture/
!dot_agents/skills/karpathy-guidelines/
!dot_agents/skills/ponytail-audit/
!dot_agents/skills/ponytail-debt/
!dot_agents/skills/ponytail-review/
!dot_agents/skills/ponytail/
!dot_agents/skills/simple-english/
!dot_agents/skills/thermo-nuclear-code-quality-review/
!dot_agents/skills/to-spec/
